#!/bin/bash
# curl simulado: la alternativa a wget para descargar la imagen base.
#   MOCK_CURL_FALLA=1  falla como si no hubiera conexión
S="${MOCK_STATE:?}"
echo "curl $*" >> "$S/log"
salida=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) salida="$2"; shift 2 ;;
        *)  shift ;;
    esac
done
[[ -n "$salida" ]] || { echo "mock curl: falta -o" >&2; exit 2; }
if [[ -n "${MOCK_CURL_FALLA:-}" ]]; then
    echo "curl: (6) Could not resolve host" >&2
    exit 6
fi
qemu-img create -f qcow2 "$salida" 3G >/dev/null
exit 0
